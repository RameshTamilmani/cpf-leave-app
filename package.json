{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:offline": "node --test scripts/test-offline.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:calendar": "node --import tsx --test scripts/test-calendar.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:holidays": "node --import tsx --test scripts/test-holidays.mjs",
    "test:profile": "node --import tsx --test scripts/test-profile.mjs",
    "test:profile-browser": "node scripts/test-profile-browser.mjs",
    "test:updates": "node --import tsx --test scripts/test-updates.mjs",
    "test:modals": "node scripts/test-modals.mjs",
    "version": "node scripts/sync-version.mjs",
    "prebuild": "node scripts/sync-version.mjs && node scripts/release-notes.mjs --build-check",
    "release:notes": "node scripts/release-notes.mjs --review",
    "test:release-notes": "node --import tsx --test scripts/test-release-notes.mjs",
    "release:check": "node scripts/release-notes.mjs --check",
    "test:leave-duration": "node --import tsx --test scripts/test-leave-duration.mjs"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
